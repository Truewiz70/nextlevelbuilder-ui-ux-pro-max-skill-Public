# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development                # development | staging | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000

# ─── Data stores ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:5432/receptionist
REDIS_URL=redis://localhost:6379/0

# Fernet key for encrypting per-tenant integration credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# ─── Voice layer (Vapi on Twilio numbers) ───────────────────────────────────
VOICE_PROVIDER=vapi                # vapi | retell (adapter selection)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# ─── Telephony / SMS (Twilio) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ─── LLM (Claude API) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL_PRIMARY=claude-sonnet-5     # in-call reasoning
LLM_MODEL_FAST=claude-haiku-4-5       # classification, summaries, lead scoring

# ─── Embeddings (knowledge base / RAG) ──────────────────────────────────────
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIMENSIONS=1024

# ─── Calendar (Google) ──────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── CRM (HubSpot) ──────────────────────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=notifications@example.com

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Guardrails ─────────────────────────────────────────────────────────────
MAX_CALL_DURATION_SECONDS=900      # hard cap per call (cost guardrail)
TENANT_DAILY_SPEND_CAP_USD=50      # per-tenant daily spend alert threshold
